# jev-firewall model key — pick ONE provider (or just run `jev-firewall setup`,
# which writes ~/.jev-firewall/.env for you).

# Option 1: TypeSafe direct (key from console.typesafe.ai)
#JEVD_PROVIDER=typesafe
#TYPESAFE_API_KEY=

# Option 2: Vercel AI Gateway (recommended; key from the Vercel dashboard, vck_…)
#JEVD_PROVIDER=gateway
#AI_GATEWAY_API_KEY=vck_
